# FROSE Street Environment Configuration
NODE_ENV=development
PORT=3100
HOST=0.0.0.0

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/frose_street

# Authentication & Security
JWT_SECRET=frose-street-dev-secret-minimum-32-characters-long
JWT_EXPIRES_IN=30d

# SMS OTP Provider (MSG91 / Twilio)
OTP_PROVIDER=mock
OTP_API_KEY=mock-otp-api-key
OTP_TEMPLATE_ID=mock-template-id

# Domain & CORS
CORS_ORIGIN=https://street.frostech.com,http://localhost:3100

# Client Web URLs
CLIENT_URL=https://street.frostech.com
