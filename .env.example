# Environment mode: development | production | test
NODE_ENV=development
PORT=3100
HOST=0.0.0.0

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://frose_user:secure_db_password_here@localhost:55432/frose_street

# Cryptographic & Session Secrets (Must be at least 32 characters in production)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_EXPIRES_IN=30d
# Ed25519 (EdDSA) Offline License Signing Keypair (PKCS8 / SPKI PEM, escape newlines as \n)
LICENSE_ED25519_PRIVATE_KEY=
LICENSE_ED25519_PUBLIC_KEY=

# CORS Allowed Origins (Comma-separated exact origins)
CORS_ORIGIN=https://street.frostech.com,http://localhost:3100

# One-time Superadmin CLI Provisioning (scripts/create-admin.ts)
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
ADMIN_BUSINESS_NAME=FROSE Platform HQ

# Test Fixtures (Used only in test environments)
TEST_VENDOR_PHONE=9177177475
TEST_PASSWORD_HASH=
TEST_PIN_HASH=
