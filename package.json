{
  "name": "frose-street",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FROSE Street — Ultra-Fast Mobile POS for Street Food Stalls & Vendors",
  "main": "./server/dist/index.js",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate:latest": "tsx server/src/db/cli.ts latest",
    "migrate:down": "tsx server/src/db/cli.ts down",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "kysely": "^0.27.3",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
